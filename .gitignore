# ---------------------------------------------------------------------------
# CloudCampus .gitignore
# Only source, infrastructure and docs are committed. Everything below is
# either regenerated by the tooling (tests, build, deploy) or machine-local.
# ---------------------------------------------------------------------------

# Build output
frontend/dist/
frontend/node_modules/
frontend/tsconfig.tsbuildinfo

# Python bytecode and test caches
__pycache__/
*.py[cod]
.pytest_cache/

# Deployment artefacts (recreated by scripts/deploy.ps1)
backend.zip
deployment-outputs.json

# Local env overrides - never commit real credentials.
# frontend/.env.production is intentionally committed: it holds only public
# identifiers (API URL, Cognito pool/client ids) and lets a fresh clone talk to
# the deployed backend.
.env
.env.local
.env.*.local

# Generated reports / documents (screenshots, docx, pdf) - never part of the app
*.docx
*.pdf
*.pptx
reports/
docs/screenshots/
screenshots/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
