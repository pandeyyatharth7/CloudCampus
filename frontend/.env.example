# Frontend environment template.
#
# Copy to `.env.local` for local development, or `.env.production` for a deploy.
# `scripts/deploy.ps1` generates `.env.production` from live stack outputs.
#
# Every value here is a PUBLIC identifier. There are no secrets in this file:
# the app uses Cognito hosted UI + PKCE, so no client secret is needed and no
# AWS credential ever reaches the browser.

# Deployed API Gateway HTTP API base URL (no trailing slash).
VITE_API_URL=https://example.execute-api.ap-south-1.amazonaws.com

# Region that hosts the Cognito user pool.
VITE_COGNITO_REGION=ap-south-1

# Cognito user pool id (e.g. ap-south-1_AbCdEfGhI).
VITE_COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxxxxxxxxxx

# Cognito app client id (public in a PKCE SPA).
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Cognito hosted UI domain (prefix domain, no https:// prefix).
VITE_COGNITO_DOMAIN=example.auth.ap-south-1.amazoncognito.com